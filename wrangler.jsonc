{
  "name": "potluck",
  "main": "./website/worker/index.ts",
  "compatibility_date": "2026-08-16",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./marketing-site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "send_email": [{ "name": "CONTACT_EMAIL", "destination_address": "joseph@getpotluck.app" }],
  "ratelimits": [
    { "name": "CONTACT_RATE", "namespace_id": "2026100401", "simple": { "limit": 5, "period": 60 } },
    { "name": "CONTACT_GLOBAL_RATE", "namespace_id": "2026100402", "simple": { "limit": 30, "period": 60 } }
  ]
}
